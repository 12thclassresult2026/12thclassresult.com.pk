{
  "name": "12thclassresult-com-pk",
  "version": "0.1.0",
  "private": true,
  "description": "12thClassResult.com.pk — Pakistani Class 12 / Second Year / HSSC Part-II result platform on Cloudflare Workers.",
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "vitest run tests/validation",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run validate && npm run test && npm run build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "stage-cache": "node scripts/stage-prerender-cache.mjs",
    "preview": "opennextjs-cloudflare build && npm run stage-cache && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && npm run stage-cache && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "pdfjs-dist": "^6.3.289",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260911.1": true
  }
}
