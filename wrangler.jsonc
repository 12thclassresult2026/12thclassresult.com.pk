{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "12thclassresult-com-pk",
  "main": ".open-next/worker.js",

  // Kept at or below the workerd release bundled with the pinned wrangler so
  // local preview behaves like production. Raise this only together with a
  // wrangler upgrade, and re-run `npm run preview` afterwards.
  "compatibility_date": "2026-08-31",
  // Both are required by @opennextjs/cloudflare for the Next.js server runtime.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  "observability": {
    "enabled": true,
  },

  // No workers.dev subdomain (section 42). Every canonical tag on this site
  // points at the apex; a second origin serving the same pages would be a
  // duplicate that the canonical system cannot see, competing with the real
  // site in search. Removing the origin is better than suppressing it later.
  "workers_dev": false,

  // PRODUCTION ROUTES — live since 2026-09-15.
  //
  // The zone question that blocked this for two days is settled: the zone was
  // never on the 11thclassresult account wrangler was logged into. It lives on
  // account 5a391134eba4e881ce7655522afb7710 (12thclassresult2026@gmail.com),
  // confirmed from the dashboard URL and then by a successful deploy.
  //
  // Two failed routed deploys proved the failure mode is safe: the Worker
  // uploads, the route attachment fails with "Could not find zone", and no DNS
  // record is written. That is why a routeless deploy is the right first step
  // on any new account.
  //
  // `www` is attached for exactly ONE purpose: giving the permanent www -> apex
  // redirect in `next.config.ts` a hostname that resolves. It must never pass
  // the production-host check in `headers()`, so that if the redirect ever
  // failed open, www emits noindex plus an apex canonical rather than quietly
  // duplicating the site. Verified live: www returns 308 to the apex, and the
  // path is preserved (`/boards` -> `/boards`, not a placeholder).
  "routes": [
    { "pattern": "12thclassresult.com.pk", "custom_domain": true },
    { "pattern": "www.12thclassresult.com.pk", "custom_domain": true },
  ],
  //
  // `www` is attached for exactly ONE purpose: giving the permanent www -> apex
  // redirect in `next.config.ts` a hostname that resolves. It must never pass
  // the production-host check in `headers()`, so that if the redirect ever
  // failed open, www emits noindex plus an apex canonical rather than quietly
  // duplicating the site.

  // No D1, KV or R2 binding is declared: nothing in this foundation needs one
  // (section 8). The account currently has no D1 databases and no KV
  // namespaces, and R2 is not enabled. Add a binding only against a real
  // requirement, using ids returned by the authenticated account - never
  // invented ones, and never a placeholder.
  "vars": {
    "NEXT_PUBLIC_SITE_ORIGIN": "https://12thclassresult.com.pk",
  },
}
