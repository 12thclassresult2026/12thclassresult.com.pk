{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "12thclassresult-com-pk",
  "main": ".open-next/worker.js",

  // Kept at or below the workerd release bundled with the pinned wrangler so
  // local preview behaves like production. Raise this only together with a
  // wrangler upgrade, and re-run `npm run preview` afterwards.
  "compatibility_date": "2026-08-31",
  // Both are required by @opennextjs/cloudflare for the Next.js server runtime.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  "observability": {
    "enabled": true,
  },

  // No workers.dev subdomain (section 42). Every canonical tag on this site
  // points at the apex; a second origin serving the same pages would be a
  // duplicate that the canonical system cannot see, competing with the real
  // site in search. Removing the origin is better than suppressing it later.
  "workers_dev": false,

  // NO `routes` ENTRY YET - THIS IS DELIBERATE.
  //
  // A `routes` entry naming a zone the authenticated account does not hold
  // fails the deploy outright, so this value must never be guessed (section 12).
  //
  // Verified so far: 12thclassresult.com.pk delegates to Cloudflare nameservers
  // (thea.ns / hasslo.ns) and publishes no address record, so a zone exists and
  // nothing is served on the domain yet. NOT yet verified: that the zone sits on
  // the authenticated account (c085ba412b1289d5950bd55daf501b51), which is the
  // 11th-class project's account and may or may not be where this site belongs.
  //
  // Add routes only after that is confirmed AND a first deploy succeeds. When
  // `www` is added it is attached for exactly one purpose - so the permanent
  // www -> apex redirect in `next.config.ts` has a hostname that resolves - and
  // it must never pass the production-host check, so that if the redirect ever
  // failed open, www emits noindex and an apex canonical instead of quietly
  // duplicating the site.

  // No D1, KV or R2 binding is declared: nothing in this foundation needs one
  // (section 8). The account currently has no D1 databases and no KV
  // namespaces, and R2 is not enabled. Add a binding only against a real
  // requirement, using ids returned by the authenticated account - never
  // invented ones, and never a placeholder.
  "vars": {
    "NEXT_PUBLIC_SITE_ORIGIN": "https://12thclassresult.com.pk",
  },
}
